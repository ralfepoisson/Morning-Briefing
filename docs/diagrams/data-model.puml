  display_name : varchar
  phonetic_name : varchar?
  avatar_data_url : text?
  avatar_url : varchar?
  timezone : varchar
  locale : varchar
  preferred_language : varchar
  telegram_chat_id : varchar?
  telegram_delivery_enabled : boolean
  is_admin : boolean
  is_active : boolean
  created_at : timestamp
  updated_at : timestamp
}

class Dashboard {
  +dashboard_id : UUID
  --
