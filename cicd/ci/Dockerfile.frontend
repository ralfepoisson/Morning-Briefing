FROM node:24-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d AS build

WORKDIR /app

ARG PUBLIC_API_BASE_URL=/api/v1
ARG PUBLIC_IDENTITY_SIGN_IN_URL=https://auth.life-sqrd.com/signIn
ARG PUBLIC_APPLICATION_ID=39863fc2-c2b9-4b5f-82ee-04841b2e9980
ARG PUBLIC_IDENTITY_SIGN_OUT_URL=
ARG PUBLIC_APP_BASE_URL=

COPY src/web/package*.json ./src/web/
COPY cicd/ci/build-frontend.sh ./cicd/ci/build-frontend.sh
COPY cicd/ci/render-frontend-config.mjs ./cicd/ci/render-frontend-config.mjs
RUN chmod +x ./cicd/ci/build-frontend.sh

COPY src/web ./src/web
RUN FRONTEND_API_BASE_URL="${PUBLIC_API_BASE_URL}" \
    FRONTEND_AUTH_SERVICE_SIGN_IN_URL="${PUBLIC_IDENTITY_SIGN_IN_URL}" \
    FRONTEND_AUTH_SERVICE_APPLICATION_ID="${PUBLIC_APPLICATION_ID}" \
    FRONTEND_AUTH_SERVICE_SIGN_OUT_URL="${PUBLIC_IDENTITY_SIGN_OUT_URL}" \
    FRONTEND_APP_BASE_URL="${PUBLIC_APP_BASE_URL}" \
    ./cicd/ci/build-frontend.sh

FROM nginx:1.29-alpine@sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de AS runtime

COPY cicd/ci/nginx-main.conf /etc/nginx/nginx.conf
COPY cicd/ci/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/src/web/dist /usr/share/nginx/html
RUN chown -R nginx:nginx /var/cache/nginx /var/run /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --output-document=- http://127.0.0.1:8080/healthz >/dev/null || exit 1

USER nginx

ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
