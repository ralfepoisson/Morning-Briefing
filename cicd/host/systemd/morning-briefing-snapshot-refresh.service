[Unit]
Description=Morning Briefing widget snapshot enqueue
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ExecStart=/srv/apps/morning-briefing/current/cicd/host/run-scheduled-job.sh snapshot-refresh
TimeoutStartSec=30min
