{
  "name": "morning-briefing-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend and database tooling for Morning Briefing",
  "type": "module",
  "scripts": {
    "build": "prisma generate && rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/app/server.ts",
    "start": "tsx src/app/server.ts",
    "start:prod": "node dist/src/app/server.js",
    "db:create": "tsx scripts/create-database.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:prod": "node dist/prisma/seed.js",
    "db:init": "npm run db:create && npm run db:migrate -- --name init && npm run db:seed",
    "db:reset": "prisma migrate reset --force",
    "reference:import:cities": "tsx scripts/import-reference-cities.ts",
    "reference:import:cities:prod": "node dist/scripts/import-reference-cities.js",
    "message-broker:setup": "tsx scripts/setup-message-broker.ts",
    "snapshot:worker": "tsx scripts/run-snapshot-worker.ts",
    "snapshot:worker:prod": "node dist/scripts/run-snapshot-worker.js",
    "snapshot:refresh:nightly": "tsx scripts/run-nightly-refresh.ts",
    "snapshot:refresh:nightly:prod": "node dist/scripts/run-nightly-refresh.js",
    "dashboard-briefing:refresh:scheduled": "tsx scripts/run-scheduled-dashboard-briefings.ts",
    "dashboard-briefing:refresh:scheduled:prod": "node dist/scripts/run-scheduled-dashboard-briefings.js",
    "scheduler:local": "tsx scripts/run-local-scheduler.ts",
    "prisma:studio": "prisma studio",
    "test": "node --test --import tsx",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:full": "tsc --noEmit -p tsconfig.json",
    "watch": "watch 'npm run build' ./"
  },
  "dependencies": {
    "@aws-sdk/client-polly": "^3.1091.0",
    "@aws-sdk/client-sesv2": "^3.1091.0",
    "@fastify/cors": "^11.2.0",
    "@prisma/client": "^6.6.0",
    "adm-zip": "^0.6.0",
    "amqplib": "^2.0.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.10.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "nodemon": "^3.1.14",
    "prisma": "^6.6.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
